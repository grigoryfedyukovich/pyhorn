(set-logic HORN)
(declare-rel inv (Int Int))
(declare-rel fail ())
(declare-var x0 Int) (declare-var x1 Int)
(declare-var y0 Int) (declare-var y1 Int)
(rule (=> (and (= x1 0) (= y1 0)) (inv x1 y1)))
(rule (=> (and (inv x0 y0) (< x0 500000000) (= x1 (+ x0 1)) (= y1 (+ y0 5))) (inv x1 y1)))
(rule (=> (and (inv x0 y0) (>= y0 2500000000)) fail))
(query fail)
